diff --git a/target/linux/qualcommax/ipq807x/base-files/lib/upgrade/api-ap8220.sh b/target/linux/qualcommax/ipq807x/base-files/lib/upgrade/api-ap8220.sh
new file mode 100755
index 0000000..1f42577
--- /dev/null
+++ b/target/linux/qualcommax/ipq807x/base-files/lib/upgrade/api-ap8220.sh
@@ -0,0 +1,414 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+AP8220_SMALL_NAND_LIMIT=$((512 * 1024 * 1024))
+AP8220_FSBOOTARGS='ubi.mtd=QWRT,4096,2 rootfstype=squashfs'
+
+ap8220_nand_span_bytes() {
+	local mtd type size offset end
+	local span=0
+
+	for mtd in /sys/class/mtd/mtd[0-9]*; do
+		[ -r "$mtd/type" ] || continue
+
+		type="$(cat "$mtd/type" 2>/dev/null)"
+		[ "$type" = "nand" ] || continue
+
+		size="$(cat "$mtd/size" 2>/dev/null)"
+		case "$size" in
+		""|*[!0-9]*)
+			continue
+			;;
+		esac
+
+		if [ -r "$mtd/offset" ]; then
+			offset="$(cat "$mtd/offset" 2>/dev/null)"
+			case "$offset" in
+			""|*[!0-9]*)
+				continue
+				;;
+			esac
+		else
+			# An exposed master MTD has no partition offset.
+			offset=0
+		fi
+
+		end=$((offset + size))
+		[ "$end" -gt "$span" ] && span="$end"
+	done
+
+	[ "$span" -gt 0 ] || return 1
+	echo "$span"
+}
+
+ap8220_count_nand_named() {
+	local mtd type name wanted
+	local count=0
+
+	for mtd in /sys/class/mtd/mtd[0-9]*; do
+		[ -r "$mtd/type" ] || continue
+		[ -r "$mtd/name" ] || continue
+
+		type="$(cat "$mtd/type" 2>/dev/null)"
+		[ "$type" = "nand" ] || continue
+
+		name="$(cat "$mtd/name" 2>/dev/null)"
+
+		for wanted in "$@"; do
+			if [ "$name" = "$wanted" ]; then
+				count=$((count + 1))
+				break
+			fi
+		done
+	done
+
+	echo "$count"
+}
+
+ap8220_find_nand_named() {
+	local wanted mtd type name
+
+	for wanted in "$@"; do
+		for mtd in /sys/class/mtd/mtd[0-9]*; do
+			[ -r "$mtd/type" ] || continue
+			[ -r "$mtd/name" ] || continue
+
+			type="$(cat "$mtd/type" 2>/dev/null)"
+			[ "$type" = "nand" ] || continue
+
+			name="$(cat "$mtd/name" 2>/dev/null)"
+			if [ "$name" = "$wanted" ]; then
+				echo "$name"
+				return 0
+			fi
+		done
+	done
+
+	return 1
+}
+
+ap8220_detect_layout() {
+	local nand_size nand_mib
+	local rootfs_count qwrt_count
+
+	nand_size="$(ap8220_nand_span_bytes)" || {
+		echo "AP8220: cannot determine NAND capacity" >&2
+		return 1
+	}
+
+	rootfs_count="$(ap8220_count_nand_named rootfs ROOTFS)"
+	qwrt_count="$(ap8220_count_nand_named qwrt QWRT)"
+	nand_mib=$((nand_size / 1024 / 1024))
+
+	echo "AP8220: NAND span ${nand_mib} MiB, rootfs=${rootfs_count}, QWRT=${qwrt_count}" >&2
+
+	if [ "$nand_size" -lt "$AP8220_SMALL_NAND_LIMIT" ]; then
+		if [ "$rootfs_count" -eq 1 ] &&
+		   [ "$qwrt_count" -eq 0 ]; then
+			echo legacy
+			return 0
+		fi
+
+		echo "AP8220: invalid small-NAND partition layout" >&2
+		return 1
+	fi
+
+	if [ "$rootfs_count" -eq 1 ] &&
+	   [ "$qwrt_count" -eq 1 ]; then
+		echo large
+		return 0
+	fi
+
+	echo "AP8220: unsupported large-NAND partition layout" >&2
+	return 1
+}
+
+ap8220_format_attach_ubi() {
+	local part="$1"
+	local max_beb_per1024="${2:-0}"
+	local mtdnum ubidev retry
+
+	mtdnum="$(find_mtd_index "$part")"
+	if [ -z "$mtdnum" ]; then
+		echo "AP8220: cannot find MTD partition $part" >&2
+		return 1
+	fi
+
+	echo "AP8220: formatting $part (/dev/mtd$mtdnum) as UBI" >&2
+
+	nand_detach_ubi "$part" >&2 || return 1
+
+	ubiformat "/dev/mtd$mtdnum" -y >&2 || {
+		echo "AP8220: cannot format MTD partition $part" >&2
+		return 1
+	}
+
+	if [ "$max_beb_per1024" -gt 0 ]; then
+		echo "AP8220: attaching $part with max_beb_per1024=$max_beb_per1024" >&2
+
+		ubiattach -m "$mtdnum" \
+			-b "$max_beb_per1024" >&2 || {
+			echo "AP8220: cannot attach UBI to $part" >&2
+			return 1
+		}
+	else
+		ubiattach -m "$mtdnum" >&2 || {
+			echo "AP8220: cannot attach UBI to $part" >&2
+			return 1
+		}
+	fi
+
+	retry=0
+	while [ "$retry" -lt 5 ]; do
+		ubidev="$(nand_find_ubi "$part")"
+
+		if [ -n "$ubidev" ]; then
+			echo "$ubidev"
+			return 0
+		fi
+
+		retry=$((retry + 1))
+		sleep 1
+	done
+
+	echo "AP8220: cannot find attached UBI device for $part" >&2
+	return 1
+}
+
+ap8220_large_upgrade_tar() {
+	local tar_file="$1"
+	local cmd="${2:-cat}"
+	local board_dir kernel_length rootfs_length rootfs_type
+	local qwrt_part root_part qwrt_ubi root_ubi
+	local qwrt_kernel_vol qwrt_rootfs_vol root_kernel_vol
+	local saved_fsbootargs
+
+	board_dir="$(
+		$cmd < "$tar_file" |
+			tar tf - |
+			grep -m 1 '^sysupgrade-.*/$'
+	)"
+	board_dir="${board_dir%/}"
+
+	if [ -z "$board_dir" ]; then
+		echo "AP8220: cannot find sysupgrade directory"
+		return 1
+	fi
+
+	kernel_length="$(
+		$cmd < "$tar_file" |
+			tar xOf - "$board_dir/kernel" |
+			wc -c
+	)"
+	rootfs_length="$(
+		$cmd < "$tar_file" |
+			tar xOf - "$board_dir/root" |
+			wc -c
+	)"
+
+	case "$kernel_length" in
+	""|0|*[!0-9]*)
+		echo "AP8220: sysupgrade image contains no valid kernel"
+		return 1
+		;;
+	esac
+
+	case "$rootfs_length" in
+	""|0|*[!0-9]*)
+		echo "AP8220: sysupgrade image contains no valid root filesystem"
+		return 1
+		;;
+	esac
+
+	rootfs_type="$(identify_tar "$tar_file" "$cmd" "$board_dir/root")"
+	if [ "$rootfs_type" != "squashfs" ]; then
+		echo "AP8220: expected squashfs root, got ${rootfs_type:-unknown}"
+		return 1
+	fi
+
+	qwrt_part="$(ap8220_find_nand_named QWRT qwrt)" || {
+		echo "AP8220: cannot find QWRT MTD partition"
+		return 1
+	}
+	root_part="$(ap8220_find_nand_named rootfs ROOTFS)" || {
+		echo "AP8220: cannot find rootfs MTD partition"
+		return 1
+	}
+
+	if [ "$qwrt_part" = "$root_part" ]; then
+		echo "AP8220: QWRT and rootfs resolve to the same partition"
+		return 1
+	fi
+
+	echo "AP8220: QWRT partition is $qwrt_part"
+	echo "AP8220: kernel-only partition is $root_part"
+
+	# QWRT UBI: kernel + rootfs + rootfs_data.
+	qwrt_ubi="$(ap8220_format_attach_ubi "$qwrt_part")" || return 1
+
+	ubimkvol "/dev/$qwrt_ubi" -n 0 -N kernel -s "$kernel_length" || {
+		echo "AP8220: cannot create QWRT/kernel"
+		return 1
+	}
+	ubimkvol "/dev/$qwrt_ubi" -n 1 -N rootfs -s "$rootfs_length" || {
+		echo "AP8220: cannot create QWRT/rootfs"
+		return 1
+	}
+	ubimkvol "/dev/$qwrt_ubi" -n 2 -N rootfs_data -m || {
+		echo "AP8220: cannot create QWRT/rootfs_data"
+		return 1
+	}
+
+	qwrt_kernel_vol="$(nand_find_volume "$qwrt_ubi" kernel)"
+	qwrt_rootfs_vol="$(nand_find_volume "$qwrt_ubi" rootfs)"
+
+	[ -n "$qwrt_kernel_vol" ] || {
+		echo "AP8220: cannot find QWRT/kernel volume"
+		return 1
+	}
+	[ -n "$qwrt_rootfs_vol" ] || {
+		echo "AP8220: cannot find QWRT/rootfs volume"
+		return 1
+	}
+
+	echo "AP8220: writing QWRT/kernel"
+	$cmd < "$tar_file" |
+		tar xOf - "$board_dir/kernel" |
+		ubiupdatevol "/dev/$qwrt_kernel_vol" -s "$kernel_length" - ||
+		return 1
+
+	echo "AP8220: writing QWRT/rootfs"
+	$cmd < "$tar_file" |
+		tar xOf - "$board_dir/root" |
+		ubiupdatevol "/dev/$qwrt_rootfs_vol" -s "$rootfs_length" - ||
+		return 1
+
+	# rootfs UBI: kernel only.
+	root_ubi="$(ap8220_format_attach_ubi "$root_part" 1)" || return 1
+
+	ubimkvol "/dev/$root_ubi" -n 0 -N kernel -s "$kernel_length" || {
+		echo "AP8220: cannot create rootfs/kernel"
+		return 1
+	}
+
+	root_kernel_vol="$(nand_find_volume "$root_ubi" kernel)"
+	[ -n "$root_kernel_vol" ] || {
+		echo "AP8220: cannot find rootfs/kernel volume"
+		return 1
+	}
+
+	echo "AP8220: writing rootfs/kernel"
+	$cmd < "$tar_file" |
+		tar xOf - "$board_dir/kernel" |
+		ubiupdatevol "/dev/$root_kernel_vol" -s "$kernel_length" - ||
+		return 1
+
+	echo "AP8220: setting U-Boot fsbootargs"
+	fw_setenv fsbootargs "$AP8220_FSBOOTARGS" || {
+		echo "AP8220: cannot set U-Boot fsbootargs"
+		return 1
+	}
+
+	saved_fsbootargs="$(fw_printenv -n fsbootargs 2>/dev/null)"
+	if [ "$saved_fsbootargs" != "$AP8220_FSBOOTARGS" ]; then
+		echo "AP8220: unexpected fsbootargs: $saved_fsbootargs"
+		return 1
+	fi
+
+	# nand_do_upgrade_success() restores sysupgrade.tgz here.
+	CI_UBIPART="$qwrt_part"
+	CI_ROOT_UBIPART="$qwrt_part"
+	CI_KERNPART=kernel
+	CI_ROOTPART=rootfs
+	unset CI_KERN_UBIPART
+
+	return 0
+}
+
+ap8220_large_do_upgrade() {
+	local file="$1"
+	local cmd
+
+	cmd="$(identify_if_gzip "$file")cat"
+
+	nand_verify_if_gzip_file "$file" "$cmd" ||
+		ap8220_upgrade_failed
+
+	nand_verify_tar_file "$file" "$cmd" ||
+		ap8220_upgrade_failed
+
+	ap8220_large_upgrade_tar "$file" "$cmd" ||
+		ap8220_upgrade_failed
+
+	ap8220_upgrade_success
+}
+
+ap8220_check_image() {
+	nand_do_platform_check "$(board_name)" "$1" || return 1
+
+	ap8220_detect_layout >/dev/null || {
+		echo "AP8220: refusing upgrade because NAND layout is unknown"
+		return 1
+	}
+
+	return 0
+}
+
+ap8220_do_upgrade() {
+	local image="$1"
+	local layout rootfs_part
+
+	layout="$(ap8220_detect_layout)" || {
+		echo "AP8220: refusing to upgrade an unknown NAND layout"
+		ap8220_upgrade_failed
+	}
+
+	case "$layout" in
+	legacy)
+		rootfs_part="$(ap8220_find_nand_named rootfs ROOTFS)" || {
+			echo "AP8220: cannot find legacy rootfs partition"
+			ap8220_upgrade_failed
+		}
+
+		echo "AP8220: using legacy NAND upgrade on $rootfs_part"
+		CI_UBIPART="$rootfs_part"
+		nand_do_upgrade "$image"
+		;;
+	large)
+		echo "AP8220: using large-NAND QWRT/rootfs upgrade"
+		ap8220_large_do_upgrade "$image"
+		;;
+	*)
+		echo "AP8220: internal layout detection error"
+		ap8220_upgrade_failed
+		;;
+	esac
+}
+
+ap8220_upgrade_failed() {
+	sync
+
+	echo
+	echo "AP8220: sysupgrade failed"
+	echo "AP8220: automatic reboot has been disabled"
+	echo "AP8220: the system remains in initramfs"
+	echo "AP8220: inspect the error and reboot manually"
+
+	exit 1
+}
+
+ap8220_upgrade_success() {
+	if ! nand_do_restore_config; then
+		echo "AP8220: cannot restore configuration"
+		ap8220_upgrade_failed
+	fi
+
+	sync
+
+	echo "AP8220: sysupgrade successful"
+
+	umount -a
+	reboot -f
+
+	sleep 5
+	exit 0
+}
\ No newline at end of file
